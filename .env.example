# Copy to .env for `docker compose up --build`.

# Two DIFFERENT random secrets, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

POSTGRES_PASSWORD=checkly
# Address the browser uses for the frontend / the API (change both when deploying).
CORS_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:3001
# 1 = load the demo user and board on start (demo@checkly.dev / demo1234). Use 0 in production.
SEED_DEMO=1
AUTH_RATE_LIMIT=10
